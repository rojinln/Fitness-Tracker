# Copy to .env and adjust as needed.

# SQLite for local dev (zero setup). For Postgres/Supabase, change the provider
# in prisma/schema.prisma to "postgresql" and set this to your connection string.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
